<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="retail_store.StoreRow">
        <tr>
           <td><t t-esc="props.store.id"/></td>
            <td>
                <a href="#" class="fw-semibold text-decoration-none"
                t-on-click.prevent="() => props.onOpenStore(props.store.id)">
                    <t t-esc="props.store.name"/>
                </a>
            </td>
            <td>
                <span class="badge bg-sucess text-uppercase">
                    <t t-esc="props.store.state"/>
                </span>
            </td>
            <td class="text-end">
                <button class="btn btn-sm btn-primary"
                t-on-click="() => props.onRunReplenishment(props.store.id)">
                    Run Replenishment
                </button>
            </td>
        </tr>
    </t>
</templates>