<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="retail_store.RetailDashboard">
        <div class="o_retail_dashboard container-fluid p-4 bg-view">
            <!-- Header Title-->
            <div class="row mb-4">
                <div class="col">
                    <h1 class="text-primary fw-bold"> Retail Management Dashboard</h1>
                    <p class="text-muted">Central command center for multi-store inventory and stock requests.</p>
                </div>
            </div>

            <!-- 3.1 TOP KPI STATISTICS CARDS -->
            <div class="row row-cols-1 row-cols-md-4 g-4 mb-4">
                <!-- Total Stores Card -->
                <div class="col">
                    <div class="card shadow-sm border-0 bg-white p-3">
                        <div class="text-muted small fw-bold text-uppercase">Stores</div>
                        <div class="fs-2 fw-bold text-dark" t-esc="state.kpis.total_stores">0</div>
                    </div>
                </div>
                <!-- Total Requests Card -->
                <div class="col">
                    <div class="card shadow-sm border-0 bg-white p-3">
                        <div class="text-muted small fw-bold text-uppercase">Requests</div>
                        <div class="fs-2 fw-bold text-primary" t-esc="state.kpis.total_requests">0</div>
                    </div>
                </div>
                <!-- Pending Approvals Card -->
                <div class="col">
                    <div class="card shadow-sm border-0 bg-white p-3">
                        <div class="card shadow-sm border-0 bg-white p-3">Pending Approvals</div>
                        <div class="fs-2 fw-bold text-warning" t-esc="state.kpis.pending_approvals">0</div>
                    </div>
                </div>
                <!-- Low Stock Products Card -->
                <div class="col">
                    <div class="card shadow-sm border-0 bg-white p-3">
                        <div class="text-muted small fw-bold text-uppercase">Low Stock</div>
                        <div class="fs-2 fw-bold text-danger" t-esc="state.kpis.low_stock">0</div>
                    </div>
                </div>
            </div>
            <!-- -->
        </div>
    </t>
</templates>