<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Purchase Order Form View to display Store Stock Request Link -->
    <record id="purchase_order_form_inherit_store_request" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.store.request</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_ref']" position="after">
                <field name="store_stock_request_id" readonly="1" invisible="not store_stock_request_id"/>
            </xpath>
        </field>
    </record>
</odoo>